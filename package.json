{
  "name": "askonly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Answer the question. Never send the file. A consent layer where the verifier never receives your document and the permission is destroyed by the network.",
  "license": "MIT",
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "preflight": "node --env-file=.env scripts/preflight.mjs",
    "arkiv:check": "node --env-file=.env scripts/arkiv-check.mjs",
    "arkiv:read": "node --env-file=.env scripts/arkiv-read.mjs",
    "ens:probe": "node --env-file=.env scripts/ens-probe.mjs",
    "zerog:check": "node --env-file=.env scripts/zerog-check.mjs",
    "compile": "node scripts/compile.mjs",
    "chain": "hardhat node --port 8546",
    "deploy": "node --env-file=.env scripts/deploy.mjs",
    "test": "node --test test/*.test.mjs",
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "api": "node --env-file=.env app/server.mjs",
    "web": "npm --prefix web run dev"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "viem": "^2.38.2"
  },
  "devDependencies": {
    "hardhat": "^2.29.1",
    "solc": "^0.8.28"
  }
}
