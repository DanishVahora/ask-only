# Arkiv (Rabdi testnet) - access key from https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=

# The writing wallet. Fund tGLM at https://hub.arkiv.network/faucet (connect-wallet only).
# Also used to deploy AskOnlyGate to Sepolia.
DEPLOYER_PRIVATE_KEY=

# Sepolia, for the live ENSv2 registry read
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 0G Private Computer. NOTE: AskOnly never ships with a key.
# In local mode your BROWSER holds this and talks to the enclave directly - the
# server never sees it. This var is only used by scripts/ and by the clearly
# labelled hosted relay mode.
ZEROG_BASE_URL=https://router-api.0g.ai/v1
ZEROG_API_KEY=
